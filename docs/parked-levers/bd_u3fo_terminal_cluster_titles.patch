index 8c7c8b13..e704fa56 100644
--- a/crates/fm-render-term/src/renderer.rs
+++ b/crates/fm-render-term/src/renderer.rs
@@ -1313,6 +1313,46 @@ impl TermRenderer {
             }
         }
 
+        // Overlay CLUSTER titles (kanban columns, flowchart subgraphs).
+        //
+        // `render_cluster_canvas` draws `canvas.draw_rect(..)` and nothing else, and nothing in this
+        // function referenced `layout.clusters` at all, so a cluster's title was drawn by every
+        // other backend and by no terminal mode. fm-render-svg draws it; the terminal drew the box
+        // and left it anonymous.
+        //
+        // This is the actual cause of bd-u3fo's headline case, and it is NOT the band label. A
+        // kanban column that the user declares reaches the layout as a CLUSTER carrying its title,
+        // not as a band: `layout_diagram_kanban_traced` returns early when
+        // `columns_are_declared_lanes`, precisely because the lanes are "already drawn as cluster
+        // boxes carrying their declared titles". So for every real parsed kanban board the band
+        // block never runs, `extensions.bands` is empty, and the band-label overlay above -- the
+        // fix that bead landed first -- has nothing to draw. Measured on `kanban / Alpha /
+        // t1[Beta]`: layout.clusters = [Some("Alpha")], extensions.bands = [].
+        //
+        // Same one-cell inset and same width budget as the band overlay above, so a title cannot
+        // spill past its own box, and the same `is_empty` skip so an untitled cluster stays blank
+        // rather than gaining a generated name.
+        for cluster_box in &layout.clusters {
+            let Some(title) = cluster_box.title.as_deref() else {
+                continue;
+            };
+            if title.is_empty() {
+                continue;
+            }
+            let (x, y, w, _h) = self.bounds_to_cells(&cluster_box.bounds, scale_x, scale_y);
+            if w < 3 || y >= lines.len() {
+                continue;
+            }
+            let budget = w - 2;
+            let label: String = self.truncate_label(title).chars().take(budget).collect();
+            for (offset, ch) in label.chars().enumerate() {
+                let col = x + 1 + offset;
+                if col < cell_width && col < lines[y].len() {
+                    lines[y][col] = ch;
+                }
+            }
+        }
+
         // Overlay node labels.
         for node_box in &layout.nodes {
             let (x, y, w, h) = self.bounds_to_cells(&node_box.bounds, scale_x, scale_y);
