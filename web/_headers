/*
  Access-Control-Allow-Origin: *

/pkg/*.wasm
  Content-Type: application/wasm
  Cache-Control: public, max-age=0, must-revalidate
  Access-Control-Allow-Origin: *

/pkg/*.js
  Content-Type: application/javascript
  Cache-Control: public, max-age=0, must-revalidate
  Access-Control-Allow-Origin: *

/pkg/*
  Cache-Control: public, max-age=0, must-revalidate

/evidence/*
  Cache-Control: public, max-age=3600, must-revalidate

/web
  Cache-Control: public, max-age=0, must-revalidate

/web/*
  Cache-Control: public, max-age=0, must-revalidate

